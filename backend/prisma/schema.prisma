generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(MEMBER)
  createdAt     DateTime       @default(now())
  address       String?
  avatarUrl     String?
  phone         String?
  notifications Notification[]
  tasks         Task[]
  workEntries   WorkEntry[]
  attendance    Attendance[]
  uploadedFiles TaskFile[]
  streamId    Int?
  stream      Stream?     @relation(fields: [streamId], references: [id], onDelete: SetNull)
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]
  leads     Lead[]
}

model Invoice {
  id       Int           @id @default(autoincrement())
  clientId Int
  amount   Float
  status   InvoiceStatus @default(UNPAID)
  dueDate  DateTime
  issuedAt DateTime      @default(now())
  paidAt   DateTime?
  client   Client        @relation(fields: [clientId], references: [id])
}

model Lead {
  id         Int        @id @default(autoincrement())
  clientId   Int?
  name       String
  phone      String?
  source     String?
  service    String?
  status     LeadStatus @default(NEW)
  followUpAt DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  client     Client?    @relation(fields: [clientId], references: [id])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  assignedTo  Int
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  deadline    DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [assignedTo], references: [id])
  files       TaskFile[]
}

model TaskFile {
  id           Int      @id @default(autoincrement())
  taskId       Int
  uploadedBy   Int
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploadedBy], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  MEMBER
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}
model WorkEntry {
  id          Int        @id @default(autoincrement())
  userId      Int
  workDate    DateTime   @db.Date
  title       String     @db.VarChar(300)
  client      String?    @db.VarChar(150)
  targetCount Int?
  doneCount   Int        @default(0)
  status      WorkStatus @default(PENDING)
  remarks     String?    @db.VarChar(1000)
  proof       String?    @db.Text
  isLate      Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isShared    Boolean    @default(false)
  files       WorkEntryFile[]
  taskType      String?    @db.VarChar(60)
  estHours      Float?
  spentHours    Float?
  isAssigned    Boolean    @default(false)
  assignedBy    Int?
  carryForward  Boolean    @default(false)
  carryReason   String?    @db.VarChar(300)
  carryCount    Int        @default(0)
  carriedFromId Int?       @unique

  carriedFrom   WorkEntry? @relation("CarryChain", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedTo     WorkEntry? @relation("CarryChain")
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId, workDate])
  @@index([workDate])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  userId    Int
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?          @db.VarChar(300)
  markedBy  Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String   @db.VarChar(150)
}

model WorkEntryLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  userId    Int
  workDate  DateTime @db.Date
  entryId   Int?
  action    String   @db.VarChar(30)
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([userId, workDate])
}

enum WorkStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model WorkEntryFile {
  id           Int       @id @default(autoincrement())
  entryId      Int
  uploadedBy   Int
  uploaderName String    @db.VarChar(100)
  byAdmin      Boolean   @default(false)
  fileName     String    @db.VarChar(255)
  fileKey      String
  fileSize     Int
  mimeType     String    @db.VarChar(150)
  createdAt    DateTime  @default(now())

  entry        WorkEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model Stream {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(60)
  countLabel   String   @default("Items") @db.VarChar(40)
  taskTypes    String[]
  requireProof Boolean  @default(false)
  createdAt    DateTime @default(now())

  users        User[]
}